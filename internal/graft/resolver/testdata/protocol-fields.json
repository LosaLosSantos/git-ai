{
  "comment": "The JSON fields of every message of the resolver protocol v1, by message. Both copies of the protocol (internal/graft/resolver and tools/graft-agents/protocol) are tested against this file, so they cannot drift: a field added to one copy fails the other's test until it is added there and here.",
  "request": ["actor", "branch", "commit", "files", "limits", "merge_base", "messages", "operation", "repository", "resolution", "tip", "version"],
  "repository": ["relative_path", "storage"],
  "messages": ["commit", "tip"],
  "file": ["base", "kind", "ours", "path", "theirs"],
  "side": ["content", "mode", "oid"],
  "limits": ["max_file_bytes"],
  "response": ["explanation", "files", "resolver", "version"],
  "response_file": ["action", "content", "hold", "mode", "origin", "path", "proposal", "report"],
  "error_response": ["error", "files"],
  "file_outcome": ["outcome", "path", "reason"],
  "check_response": ["files", "operation", "resolver", "version"],
  "check_file": ["ok", "path", "reason", "syntax"]
}
