{
  "comment": "Test vectors of the never-send rules (PLAN10 3.4), shared by internal/graft/resolver (SendRules.Reason) and tools/graft-agents/resolve/bench (notSentReason) so that the two copies cannot drift. A side is a list of parts, each part text repeated repeat times (default 1), or null when the side is absent.",
  "max_file_bytes": 1048576,
  "cases": [
    {"name": "plain source", "path": "a/b.go", "sides": [[{"text": "package b\n"}], [{"text": "package b\n\nvar x = 1\n"}]], "want": ""},
    {"name": "lockfile", "path": "web/package-lock.json", "sides": [[{"text": "{}\n"}]], "want": "lockfile"},
    {"name": "go.sum", "path": "go.sum", "sides": [[{"text": "a v1 h1:x\n"}]], "want": "lockfile"},
    {"name": "lockfile name elsewhere in the path", "path": "go.sum/notes.txt", "sides": [[{"text": "x\n"}]], "want": ""},
    {"name": "binary", "path": "img.go", "sides": [[{"text": "a\u0000b"}]], "want": "binary"},
    {"name": "large", "path": "big.go", "sides": [[{"text": "x", "repeat": 1048577}]], "want": "large"},
    {"name": "exactly max_file_bytes", "path": "edge.txt", "sides": [[{"text": "x\n", "repeat": 524288}]], "want": ""},
    {"name": "large wins over binary", "path": "big.bin", "sides": [[{"text": "\u0000"}, {"text": "x", "repeat": 1048577}]], "want": "large"},
    {"name": "binary wins over lockfile", "path": "yarn.lock", "sides": [[{"text": "\u0000"}]], "want": "binary"},
    {"name": "linguist-generated", "path": "api/client.go", "generated": true, "sides": [[{"text": "package api\n"}]], "want": "generated"},
    {"name": "lockfile wins over generated", "path": "Cargo.lock", "generated": true, "sides": [[{"text": "x\n"}]], "want": "lockfile"},
    {"name": "Go generated marker", "path": "x.pb.go", "sides": [[{"text": "// Code generated by protoc-gen-go. DO NOT EDIT.\npackage x\n"}]], "want": "generated"},
    {"name": "@generated in line 3", "path": "x.js", "sides": [[{"text": "/**\n * x\n * @generated\n */\n"}]], "want": "generated"},
    {"name": "marker in line 10", "path": "y.js", "sides": [[{"text": "l\n", "repeat": 9}, {"text": "// @generated\n"}]], "want": "generated"},
    {"name": "marker in line 11 is not looked at", "path": "z.js", "sides": [[{"text": "l\n", "repeat": 10}, {"text": "// @generated\n"}]], "want": ""},
    {"name": "auto-generated, any case", "path": "w.py", "sides": [[{"text": "# Auto-Generated file\nx = 1\n"}]], "want": "generated"},
    {"name": "marker on one side only", "path": "v.go", "sides": [[{"text": "package v\n"}], [{"text": "// DO NOT EDIT\npackage v\n"}]], "want": "generated"},
    {"name": "minified glob", "path": "static/app.min.js", "sides": [[{"text": "var a=1;\n"}]], "want": "minified"},
    {"name": "bundle glob", "path": "main.bundle.js", "sides": [[{"text": "x\n"}]], "want": "minified"},
    {"name": "longest line over 5000", "path": "long.js", "sides": [[{"text": "x", "repeat": 5001}, {"text": "\n"}]], "want": "minified"},
    {"name": "line of exactly 5000 among short ones", "path": "edge.js", "sides": [[{"text": "x", "repeat": 5000}, {"text": "\n"}, {"text": "y\n", "repeat": 20}]], "want": ""},
    {"name": "average line over 300", "path": "dense.js", "sides": [[{"text": "x", "repeat": 300}, {"text": "\n"}, {"text": "x", "repeat": 300}, {"text": "\n"}, {"text": "x", "repeat": 300}, {"text": "\n"}, {"text": "x", "repeat": 300}, {"text": "\n"}, {"text": "x", "repeat": 300}, {"text": "\n"}, {"text": "x", "repeat": 300}, {"text": "\n"}, {"text": "x", "repeat": 300}, {"text": "\n"}, {"text": "x", "repeat": 300}, {"text": "\n"}]], "want": "minified"},
    {"name": "average line of exactly 300 bytes", "path": "even.js", "sides": [[{"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}, {"text": "x", "repeat": 299}, {"text": "\n"}]], "want": ""},
    {"name": "small file with long lines", "path": "small.js", "sides": [[{"text": "x", "repeat": 2000}, {"text": "\n"}]], "want": ""},
    {"name": "no final newline", "path": "nofinal.js", "sides": [[{"text": "x", "repeat": 2100}]], "want": "minified"},
    {"name": "absent side", "path": "gone.go", "sides": [null, [{"text": "package gone\n"}]], "want": ""}
  ]
}
