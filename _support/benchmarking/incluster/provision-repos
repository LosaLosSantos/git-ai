#!/usr/bin/env python3
"""
provision-repos - idempotently provision benchmark repositories in a
chart-installed GitLab and write their hashed disk paths back into the
experiment's config.yml.

The in-cluster flow has no filesystem access to storage nodes, so repos
are created and imported via Rails APIs rather than cloned onto disk.

For A/B comparisons a second, identical project set (BENCH_CONTROL_GROUP)
is provisioned onto the control Gitaly's Rails storage
(CONTROL_STORAGE_NAME) through the same pipeline, so both sides start
from identically constructed state. Skipped when the storage isn't
registered in Rails.

Each set is made public, swept of stray workload refs, fetched when the
pinned `revision` is missing, pinned on its default branch, and given
the `additional_refs` zzz refs through Gitaly's write path. Re-runs are
safe: existing projects are reused.

Usage:
    EXPERIMENT=incluster-master ./incluster/provision-repos
    EXPERIMENT=incluster-master ./incluster/provision-repos --write-config

The first form prints the YAML snippet for review; the second edits
config.yml in place.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time
from pathlib import Path

# ruamel.yaml roundtrips comments and key order; fall back to PyYAML
# (already required elsewhere) - still valid YAML, just reformatted.
try:
    from ruamel.yaml import YAML  # type: ignore

    _yaml = YAML()
    _yaml.preserve_quotes = True
    _yaml.indent(mapping=2, sequence=2, offset=0)

    def _load(p: Path):
        with p.open() as f:
            return _yaml.load(f)

    def _dump(data, p: Path) -> None:
        with p.open("w") as f:
            _yaml.dump(data, f)

except ImportError:
    import yaml  # type: ignore

    def _load(p: Path):
        with p.open() as f:
            return yaml.safe_load(f)

    def _dump(data, p: Path) -> None:
        with p.open("w") as f:
            yaml.safe_dump(data, f, sort_keys=False)


SCRIPT_DIR = Path(__file__).resolve().parent
BENCH_DIR = SCRIPT_DIR.parent

# Group namespacing the benchmark projects.
BENCH_GROUP = os.environ.get("BENCH_GROUP", "bench")

# Control-side project set for A/B comparisons (see module docstring).
BENCH_CONTROL_GROUP = os.environ.get("BENCH_CONTROL_GROUP", f"{BENCH_GROUP}-control")
CONTROL_STORAGE_NAME = os.environ.get("CONTROL_STORAGE_NAME", "benchmark-control")

# Namespace where the GitLab Helm chart lives; matches run-benchmarks-incluster.
GITLAB_NAMESPACE = os.environ.get("GITLAB_NAMESPACE", "gitlab")

# The chart ships gitlab-toolbox with app=toolbox.
TOOLBOX_SELECTOR = os.environ.get("TOOLBOX_SELECTOR", "app=toolbox")

# Sidekiq import poll loop.
POLL_INTERVAL_SECONDS = int(os.environ.get("PROVISION_POLL_INTERVAL", "15"))
POLL_TIMEOUT_SECONDS = int(os.environ.get("PROVISION_POLL_TIMEOUT", "1800"))


def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def _kubectl_cmd() -> list[str]:
    cmd = ["kubectl"]
    if kc := os.environ.get("KUBECONFIG"):
        cmd += [f"--kubeconfig={kc}"]
    if ctx := os.environ.get("KUBE_CONTEXT"):
        cmd += [f"--context={ctx}"]
    return cmd


def find_toolbox_pod() -> str:
    out = subprocess.run(
        _kubectl_cmd()
        + [
            "-n",
            GITLAB_NAMESPACE,
            "get",
            "pods",
            "-l",
            TOOLBOX_SELECTOR,
            "-o",
            "jsonpath={.items[0].metadata.name}",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    pod = out.stdout.strip()
    if not pod:
        die(
            f"no toolbox pod found in namespace {GITLAB_NAMESPACE!r} "
            f"matching selector {TOOLBOX_SELECTOR!r}.\n"
            f"  stderr: {out.stderr.strip()}\n"
            "  Override the lookup with GITLAB_NAMESPACE / TOOLBOX_SELECTOR."
        )
    return pod


def rails_runner(pod: str, script: str, env: dict[str, str] | None = None) -> str:
    """Execute a Ruby snippet via `gitlab-rails runner -` inside the toolbox pod.

    The script goes over stdin (the `-` arg) to avoid quoting a multi-line
    Ruby program through `kubectl exec`; parameters ride in an `env KEY=VALUE`
    prefix because kubectl exec has no --env flag. Returns stdout; aborts on
    non-zero exit.
    """
    extra_env = env or {}
    env_prefix: list[str] = []
    if extra_env:
        env_prefix = ["env"] + [f"{k}={v}" for k, v in extra_env.items()]
    cmd = _kubectl_cmd() + [
        "-n",
        GITLAB_NAMESPACE,
        "exec",
        "-i",
        pod,
        "--",
        *env_prefix,
        "gitlab-rails",
        "runner",
        "-",
    ]
    proc = subprocess.run(
        cmd, input=script, capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        die(
            "gitlab-rails runner failed:\n"
            f"  exit_code={proc.returncode}\n"
            f"  command: {shlex.join(cmd)}\n"
            f"  stdout:\n{proc.stdout}\n"
            f"  stderr:\n{proc.stderr}"
        )
    return proc.stdout


# Creates (or finds) projects under the group, printing one JSON object per
# line. Parameters arrive via ENV so the Ruby source needs no escaping.
# Groups::CreateService returns a ServiceResponse (payload[:group]) on newer
# GitLab but the Group directly on older versions; probe via respond_to?.
_PROVISION_SCRIPT = r"""
require 'json'

group_path = ENV.fetch('PROVISION_GROUP')
specs = JSON.parse(ENV.fetch('PROVISION_SPECS'))

user = User.find_by_username('root') || User.admins.first
unless user
  STDERR.puts 'no admin user available; cannot create projects'
  exit 1
end

# Public so the benchmark Job can clone anonymously over http.
# update_column skips instance-level visibility validations on purpose.
public_level = Gitlab::VisibilityLevel::PUBLIC

ns = Namespace.find_by_full_path(group_path)
unless ns
  # GitLab 16.11+ requires groups/projects to belong to an Organization;
  # attach the default org when present. Older versions ignore the arg.
  org = nil
  if defined?(::Organizations::Organization)
    org = ::Organizations::Organization.find_by(path: 'default') ||
          ::Organizations::Organization.first
  end
  attrs = {
    name: group_path, path: group_path, visibility_level: public_level
  }
  attrs[:organization_id] = org.id if org

  result = Groups::CreateService.new(user, attrs).execute
  ns = if result.respond_to?(:payload)
         result.payload[:group] || result.payload['group']
       else
         result
       end
  if ns.nil? || (ns.respond_to?(:persisted?) && !ns.persisted?)
    err = ns.respond_to?(:errors) ? ns.errors.full_messages.join(', ') : result.inspect
    STDERR.puts "FAIL group #{group_path}: #{err}"
    exit 1
  end
end

ns.update_column(:visibility_level, public_level) if ns.visibility_level != public_level

specs.each do |spec|
  name = spec.fetch('name')
  url  = spec.fetch('remote')
  full = "#{group_path}/#{name}"

  storage = ENV['PROVISION_STORAGE'].to_s

  project = Project.find_by_full_path(full)
  if !project.nil? && !storage.empty? && project.repository_storage != storage
    puts JSON.generate(name: name,
                       error: "exists on storage #{project.repository_storage}, want #{storage}; re-run with --reset")
    next
  end
  if project.nil?
    project_attrs = {
      name: name, path: name, namespace_id: ns.id,
      visibility_level: public_level, import_url: url
    }
    project_attrs[:repository_storage] = storage unless storage.empty?
    project_attrs[:organization_id] = ns.organization_id if ns.respond_to?(:organization_id) && ns.organization_id
    project = ::Projects::CreateService.new(user, project_attrs).execute
    unless project.respond_to?(:persisted?) && project.persisted?
      err = project.respond_to?(:errors) ? project.errors.full_messages.join(', ') : project.inspect
      puts JSON.generate(name: name, error: err)
      next
    end
  end

  if project.visibility_level != public_level
    project.update_column(:visibility_level, public_level)
  end

  puts JSON.generate(
    name:           name,
    full_path:      project.full_path,
    disk_path:      project.disk_path,
    gl_repository:  "project-#{project.id}",
    repo_storage:   project.repository_storage,
    import_status:  project.import_status
  )
end
""".strip()


# Reset destroys the whole project instead of re-importing in place: an
# MVCC repo recreated at its old hashed path reads a stale manifest and
# is permanently broken. Callers re-resolve disk_path via --write-config.
_RESET_SCRIPT = r"""
require 'json'

group_path = ENV.fetch('PROVISION_GROUP')
specs = JSON.parse(ENV.fetch('PROVISION_SPECS'))

user = User.find_by_username('root') || User.admins.first
unless user
  STDERR.puts 'no admin user available; cannot destroy projects'
  exit 1
end

specs.each do |spec|
  name = spec.fetch('name')
  project = Project.find_by_full_path("#{group_path}/#{name}")
  if project.nil?
    puts JSON.generate(name: name, reset: true, skipped: true, reason: 'project not found')
    next
  end

  ::Projects::DestroyService.new(project, user).execute
  # Guard against the project row lingering (adjourned deletion etc.),
  # which would make the recreate fail with "path already taken".
  20.times do
    break if Project.find_by_full_path("#{group_path}/#{name}").nil?
    sleep 3
  end
  if Project.find_by_full_path("#{group_path}/#{name}")
    puts JSON.generate(name: name, error: 'project still present after destroy')
    next
  end
  puts JSON.generate(name: name, reset: true)
end
""".strip()


_STATUS_SCRIPT = r"""
require 'json'
group_path = ENV.fetch('PROVISION_GROUP')
names = JSON.parse(ENV.fetch('PROVISION_NAMES'))
names.each do |name|
  p = Project.find_by_full_path("#{group_path}/#{name}")
  if p.nil?
    puts JSON.generate(name: name, missing: true)
    next
  end
  # -1 means unreadable; lets the caller tell a failed import from Rails
  # post-import bookkeeping failures.
  branches = begin
    p.repository.raw_repository.branch_count
  rescue StandardError
    -1
  end
  puts JSON.generate(
    name: name,
    import_status: p.import_status,
    import_error:  p.import_state&.last_error,
    repo_exists:   p.repository.exists?,
    branches:      branches
  )
end
""".strip()


# Imports never fetch again, so a `revision` bumped past the import date
# can't resolve; fetch heads+tags, forced, never pruned (local-only zzz
# refs must survive), via FetchRemote. No-op when the pin resolves.
_FETCH_MISSING_REVISIONS_SCRIPT = r"""
require 'json'

group_path = ENV.fetch('PROVISION_GROUP')
specs = JSON.parse(ENV.fetch('PROVISION_SPECS'))

refmap = ['+refs/heads/*:refs/heads/*', '+refs/tags/*:refs/tags/*']

specs.each do |spec|
  name = spec.fetch('name')
  rev  = spec['revision'].to_s
  next if rev.empty?

  project = Project.find_by_full_path("#{group_path}/#{name}")
  if project.nil?
    puts JSON.generate(name: name, error: 'project not found')
    next
  end

  if project.repository.commit(rev)
    puts JSON.generate(name: name, fetched: false)
    next
  end

  url = spec['remote'].to_s
  if url.empty?
    puts JSON.generate(name: name,
                       error: "revision #{rev} missing and no remote to fetch from")
    next
  end

  raw = project.repository.raw_repository
  begin
    begin
      raw.fetch_remote(url, refmap: refmap, forced: true, prune: false)
    rescue ArgumentError
      # Older GitLab: fetch_remote without a prune kwarg (defaults safe here
      # because the refmap only covers heads/tags, not refs/refs/zzz-*).
      raw.fetch_remote(url, refmap: refmap, forced: true)
    end
  rescue StandardError => e
    puts JSON.generate(name: name,
                       error: "fetch from #{url} failed: #{e.class}: #{e.message}")
    next
  end

  begin
    project.repository.expire_branches_cache
  rescue StandardError
  end

  if project.repository.commit(rev)
    puts JSON.generate(name: name, fetched: true)
  else
    puts JSON.generate(name: name,
                       error: "revision #{rev} still not found after fetching #{url} (remote rewritten?)")
  end
end
""".strip()


# Pin the default branch to config.yml's `revision` (via WriteRef) so
# both sides serve identical content. No-op when already pinned.
_ENFORCE_REVISION_SCRIPT = r"""
require 'json'

group_path = ENV.fetch('PROVISION_GROUP')
specs = JSON.parse(ENV.fetch('PROVISION_SPECS'))

specs.each do |spec|
  name = spec.fetch('name')
  rev  = spec['revision'].to_s
  next if rev.empty?

  project = Project.find_by_full_path("#{group_path}/#{name}")
  if project.nil?
    puts JSON.generate(name: name, error: 'project not found')
    next
  end

  commit = project.repository.commit(rev)
  if commit.nil?
    puts JSON.generate(name: name, error: "revision #{rev} not found (remote rewritten?)")
    next
  end

  branch = project.default_branch || 'master'
  ref = "refs/heads/#{branch}"
  current = project.repository.commit(branch)&.sha
  if current == commit.sha
    puts JSON.generate(name: name, ref: ref, revision: commit.sha, changed: false)
  else
    project.repository.raw_repository.write_ref(ref, commit.sha)
    begin
      project.repository.expire_branches_cache
    rescue StandardError
    end
    puts JSON.generate(name: name, ref: ref, revision: commit.sha, changed: true, previous: current)
  end
end
""".strip()


# Sweep refs an aborted k6 run leaves behind (refs/test/*, benchmark-*
# branches) before pinning, via ListRefs/DeleteRefs.
_SWEEP_REFS_SCRIPT = r"""
require 'json'

group_path = ENV.fetch('PROVISION_GROUP')
names = JSON.parse(ENV.fetch('PROVISION_NAMES'))

STRAY_PREFIXES = ['refs/test/', 'refs/heads/benchmark-'].freeze

names.each do |name|
  project = Project.find_by_full_path("#{group_path}/#{name}")
  if project.nil?
    puts JSON.generate(name: name, error: 'project not found')
    next
  end

  raw = project.repository.raw_repository
  unless raw.respond_to?(:list_refs)
    puts JSON.generate(name: name, swept: 0,
                       warning: 'list_refs unavailable on this GitLab; sweep skipped')
    next
  end

  # List broadly, filter client-side: for-each-ref prefixes only match
  # at '/' boundaries, so 'refs/heads/benchmark-' can't be a pattern.
  stray = raw.list_refs(['refs/test/', 'refs/heads/'],
                        dynamic_timeout: Gitlab::GitalyClient.long_timeout)
             .map(&:name)
             .select { |n| STRAY_PREFIXES.any? { |p| n.start_with?(p) } }

  if stray.empty?
    puts JSON.generate(name: name, swept: 0)
    next
  end

  stray.each_slice(1000) { |batch| raw.delete_refs(*batch) }
  begin
    project.repository.expire_branches_cache
  rescue StandardError
  end
  puts JSON.generate(name: name, swept: stray.size)
end
""".strip()


# Create the refs/refs/zzz-N refs on the pinned revision via bulk
# UpdateReferences. The stream is built by hand because raw.update_refs
# sets `repository` on every message, which Gitaly rejects once a call
# spans multiple 100-ref slices.
_ADDITIONAL_REFS_SCRIPT = r"""
require 'json'

group_path = ENV.fetch('PROVISION_GROUP')
specs = JSON.parse(ENV.fetch('PROVISION_SPECS'))
batch_size = Integer(ENV.fetch('PROVISION_REF_BATCH', '50000'))

bulk_update_refs = lambda do |raw, updates|
  requests = Enumerator.new do |y|
    updates.each_slice(100).with_index do |slice, i|
      msgs = slice.map do |u|
        Gitaly::UpdateReferencesRequest::Update.new(
          old_object_id: u[:old_sha],
          new_object_id: u[:new_sha],
          reference: u[:reference]
        )
      end
      args = { updates: msgs }
      args[:repository] = raw.gitaly_repository if i.zero?
      y.yield Gitaly::UpdateReferencesRequest.new(**args)
    end
  end
  Gitlab::GitalyClient.call(raw.storage, :ref_service, :update_references,
                            requests, timeout: Gitlab::GitalyClient.long_timeout)
end

bulk_delete_refs = lambda do |raw, refs|
  response = Gitlab::GitalyClient.call(
    raw.storage, :ref_service, :delete_refs,
    Gitaly::DeleteRefsRequest.new(repository: raw.gitaly_repository, refs: refs),
    timeout: Gitlab::GitalyClient.long_timeout
  )
  raise "DeleteRefs: #{response.git_error}" unless response.git_error.to_s.empty?
end

specs.each do |spec|
  name  = spec.fetch('name')
  count = spec.fetch('additional_refs').to_i
  next if count <= 0

  project = Project.find_by_full_path("#{group_path}/#{name}")
  if project.nil?
    puts JSON.generate(name: name, error: 'project not found')
    next
  end

  # Raw (uncached) RPCs throughout: Rails' repository.ref_exists? can
  # serve a stale cache entry from a destroyed-and-recreated project.
  raw = project.repository.raw_repository

  # Skip only when the exact expected set exists. Probing sentinel refs
  # (zzz-1, zzz-#{count}) instead would miss an interrupted sweep (deletion
  # goes in lexicographic order, so both sentinels fall in the first batch)
  # and a changed additional_refs count, stranding stale refs.
  # use longer timeout so 6-figure ref deletion can still work
  existing = raw.list_refs(['refs/refs/'],
                           dynamic_timeout: Gitlab::GitalyClient.long_timeout)
                .map(&:name)
                .select { |n| n.start_with?('refs/refs/zzz-') }
  expected = (1..count).map { |i| "refs/refs/zzz-#{i}" }
  if existing.sort == expected.sort
    puts JSON.generate(name: name, refs: count, skipped: true)
    next
  end

  # A partial set can't be resumed (creations assert the ref doesn't exist
  # yet, old_object_id all-zeroes); sweep leftovers first.
  unless existing.empty?
    existing.each_slice(1000) { |b| bulk_delete_refs.call(raw, b) }
    STDERR.puts "#{name}: swept #{existing.size} stale zzz refs"
  end

  anchor = spec['revision'].to_s
  anchor = project.default_branch || 'master' if anchor.empty?
  commit = project.repository.commit(anchor)
  if commit.nil?
    puts JSON.generate(name: name, error: "anchor #{anchor} not found")
    next
  end
  sha = commit.sha

  blank = '0' * sha.length
  (1..count).each_slice(batch_size) do |batch|
    bulk_update_refs.call(raw, batch.map { |i|
      { old_sha: blank, new_sha: sha, reference: "refs/refs/zzz-#{i}" }
    })
    STDERR.puts "#{name}: refs/refs/zzz-#{batch.last} of #{count}"
  end

  unless raw.ref_exists?("refs/refs/zzz-#{count}")
    puts JSON.generate(name: name,
                       error: "refs/refs/zzz-#{count} still missing after creation; the write path is dropping refs")
    next
  end

  puts JSON.generate(name: name, refs: count, anchor: sha)
rescue StandardError => e
  # One slow repo must not abort the whole runner
  puts JSON.generate(name: name, error: "#{e.class}: #{e.message}")
end
""".strip()


