if user.nil?
  puts JSON.generate(error: 'no admin user available; cannot create PAT')
  exit
end

name = 'gitaly-benchmark'
user.personal_access_tokens.active.where(name: name).find_each(&:revoke!)
token = user.personal_access_tokens.create!(
