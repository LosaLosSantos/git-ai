def rails_storages(pod: str) -> list[str]:
    """Names of the Gitaly storages registered in Rails."""
    out = rails_runner(
        pod,
        "require 'json'; puts JSON.generate(Gitlab.config.repositories.storages.keys)",
    )
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("["):
            return json.loads(line)
    return []


def provision(pod: str, group: str, storage: str, specs: list[dict]) -> dict[str, dict]:
    """Create projects (idempotently) and return per-name metadata."""
    out = rails_runner(
        pod,
        _PROVISION_SCRIPT,
        env={
            "PROVISION_GROUP": group,
            "PROVISION_STORAGE": storage,
            "PROVISION_SPECS": json.dumps(specs),
        },
    )
    results: dict[str, dict] = {}
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            # Rails prints deprecation warnings to stdout; skip non-JSON lines.
            continue
        rec = json.loads(line)
        results[rec["name"]] = rec
    # A project silently created on the wrong storage would make the
    # comparison measure the wrong Gitaly; fail instead.
    for rec in results.values():
        if storage and not rec.get("error") and rec.get("repo_storage") != storage:
            rec["error"] = (
                f"created on storage {rec.get('repo_storage')!r}, wanted "
                f"{storage!r} (does Projects::CreateService honor "
                "repository_storage on this GitLab version?)"
            )
    return results


def reset_repositories(pod: str, group: str, specs: list[dict]) -> None:
    """Destroy the bench projects so provisioning recreates them fresh."""
    out = rails_runner(
        pod,
        _RESET_SCRIPT,
        env={
            "PROVISION_GROUP": group,
            "PROVISION_SPECS": json.dumps(specs),
        },
    )
    reset_names = set()
    errors = []
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        rec = json.loads(line)
        if rec.get("error"):
            errors.append(f"{rec['name']}: {rec['error']}")
            continue
        if rec.get("reset"):
            reset_names.add(rec["name"])
            state = "already absent" if rec.get("skipped") else "destroyed"
            print(f"  {group}/{rec['name']}: {state}", file=sys.stderr)
    missing = [
        s["name"]
        for s in specs
        if s["name"] not in reset_names
        and not any(e.startswith(f"{s['name']}:") for e in errors)
    ]
    if errors or missing:
        die(
            "repository reset failed:\n  "
            + "\n  ".join(errors + [f"{n}: no reset confirmation" for n in missing])
        )


def wait_for_imports(pod: str, group: str, names: list[str]) -> dict[str, dict]:
    """Poll Sidekiq import status until every project is finished/failed."""
    deadline = time.monotonic() + POLL_TIMEOUT_SECONDS
    last: dict[str, dict] = {}
    while True:
        out = rails_runner(
            pod,
            _STATUS_SCRIPT,
            env={
                "PROVISION_GROUP": group,
                "PROVISION_NAMES": json.dumps(names),
            },
        )
        last = {}
        for line in out.splitlines():
            line = line.strip()
            if not line.startswith("{"):
                continue
            rec = json.loads(line)
            last[rec["name"]] = rec

        pending = [
            n
            for n in names
            if last.get(n, {}).get("import_status")
            not in (None, "finished", "failed", "none")
        ]
        for n in names:
            r = last.get(n, {})
            print(
                f"  {group}/{n}: import_status="
                f"{r.get('import_status', '?')} "
                f"repo_exists={r.get('repo_exists', '?')}",
                file=sys.stderr,
            )
        if not pending:
            return last
        if time.monotonic() > deadline:
            die(
                f"timed out after {POLL_TIMEOUT_SECONDS}s waiting for imports: "
                f"{pending}"
            )
        time.sleep(POLL_INTERVAL_SECONDS)


def fetch_missing_revisions(pod: str, group: str, specs: list[dict]) -> None:
    """Fetch a repo's remote when its pinned revision is absent locally.

    Repos whose pin already resolves are untouched, so bumping `revision:`
    in config.yml self-heals after the one-time import goes stale.
    """
    pinned = [s for s in specs if s.get("revision")]
    if not pinned:
        return
    out = rails_runner(
        pod,
        _FETCH_MISSING_REVISIONS_SCRIPT,
        env={
            "PROVISION_GROUP": group,
            "PROVISION_SPECS": json.dumps(pinned),
        },
    )
    errors = []
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        rec = json.loads(line)
        if rec.get("error"):
            errors.append(f"{rec['name']}: {rec['error']}")
            continue
        state = "fetched from remote" if rec.get("fetched") else "already present"
        print(
            f"  {group}/{rec['name']}: pinned revision {state}",
            file=sys.stderr,
        )
    if errors:
        die("revision fetch failed:\n  " + "\n  ".join(errors))


def enforce_revisions(pod: str, group: str, specs: list[dict]) -> None:
    """Reset each project's default branch to its pinned revision."""
    pinned = [s for s in specs if s.get("revision")]
    if not pinned:
        return
    out = rails_runner(
        pod,
        _ENFORCE_REVISION_SCRIPT,
        env={
            "PROVISION_GROUP": group,
            "PROVISION_SPECS": json.dumps(pinned),
        },
    )
    errors = []
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        rec = json.loads(line)
        if rec.get("error"):
            errors.append(f"{rec['name']}: {rec['error']}")
            continue
        state = "pinned" if rec.get("changed") else "already-pinned"
        print(
            f"  {group}/{rec['name']}: {rec['ref']} -> "
            f"{rec['revision']} ({state})",
            file=sys.stderr,
        )
    if errors:
        die("revision enforcement failed:\n  " + "\n  ".join(errors))


def sweep_stray_refs(pod: str, group: str, names: list[str]) -> None:
    """Delete refs/test/* and benchmark-* branches left by previous runs."""
    out = rails_runner(
        pod,
        _SWEEP_REFS_SCRIPT,
        env={
            "PROVISION_GROUP": group,
            "PROVISION_NAMES": json.dumps(names),
        },
    )
    errors = []
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        rec = json.loads(line)
        if rec.get("error"):
            errors.append(f"{rec['name']}: {rec['error']}")
            continue
        msg = f"  {group}/{rec['name']}: swept {rec['swept']} stray refs"
        if rec.get("warning"):
            msg += f" ({rec['warning']})"
        print(msg, file=sys.stderr)
    if errors:
        die("stray-ref sweep failed:\n  " + "\n  ".join(errors))


def create_additional_refs(pod: str, group: str, specs: list[dict]) -> None:
    """Create the zzz benchmark refs through the write path.

    Mirrors the VM flow (roles/gitaly/tasks/initialize.yml) so every
    provisioned project set carries the same ref load.
    """
    wanted = [s for s in specs if s.get("additional_refs")]
    if not wanted:
        return
    out = rails_runner(
        pod,
        _ADDITIONAL_REFS_SCRIPT,
        env={
            "PROVISION_GROUP": group,
            "PROVISION_SPECS": json.dumps(wanted),
            "PROVISION_REF_BATCH": os.environ.get("PROVISION_REF_BATCH", "50000"),
        },
    )
    errors = []
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        rec = json.loads(line)
        if rec.get("error"):
            errors.append(f"{rec['name']}: {rec['error']}")
            continue
        state = "already-present" if rec.get("skipped") else "created"
        print(
            f"  {group}/{rec['name']}: {rec['refs']} refs ({state})",
            file=sys.stderr,
        )
    if errors:
        die("additional-refs creation failed:\n  " + "\n  ".join(errors))


def mint_push_token(pod: str) -> None:
    """Mint the benchmark PAT and store it as the gitaly-benchmark-pat Secret
    (key `token`), which the Job's http push transport reads via secretKeyRef.
    The cleartext goes kubectl-stdin -> Secret, never printed or on disk."""
    out = rails_runner(pod, _PAT_SCRIPT)
    rec: dict = {}
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("{"):
            rec = json.loads(line)
    if rec.get("error") or not rec.get("token"):
        die(f"PAT provisioning failed: {rec.get('error') or out.strip()}")
    _store_secret("gitaly-benchmark-pat", {"token": rec["token"]})
    print(
        f"  PAT for {rec['user']} (expires {rec['expires_at']}) stored in "
        f"secret gitaly-benchmark-pat/{GITLAB_NAMESPACE}",
        file=sys.stderr,
    )


def _store_secret(name: str, data: dict[str, str]) -> None:
    """Apply an Opaque Secret. Cleartext goes over kubectl's stdin, not
    argv, which is world-readable in `ps`."""
    manifest = json.dumps(
        {
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {"name": name, "namespace": GITLAB_NAMESPACE},
            "type": "Opaque",
            "data": {
                k: base64.b64encode(v.encode()).decode() for k, v in data.items()
            },
        }
    )
    apply = subprocess.run(
        _kubectl_cmd() + ["apply", "-f", "-"],
        input=manifest,
        capture_output=True,
        text=True,
        check=False,
    )
    if apply.returncode != 0:
        die(f"storing secret {name} failed: {apply.stderr.strip()}")


def mint_ssh_key(pod: str) -> None:
    """Provision the ssh transport's keypair: public half onto the admin
    user, private half into a Secret. Fresh each run (GitLab keeps only
    the public half)."""
    with tempfile.TemporaryDirectory() as tmp:
        key_path = Path(tmp) / "id_ed25519"
        keygen = subprocess.run(
            ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C",
             "gitaly-benchmark", "-f", str(key_path)],
            capture_output=True,
            text=True,
            check=False,
        )
        if keygen.returncode != 0:
            die(f"ssh-keygen failed: {keygen.stderr.strip() or keygen.stdout.strip()}")
        private_key = key_path.read_text()
        public_key = Path(f"{key_path}.pub").read_text().strip()

    out = rails_runner(pod, _SSH_KEY_SCRIPT, env={"BENCH_SSH_PUBKEY": public_key})
    rec: dict = {}
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("{"):
            rec = json.loads(line)
    if rec.get("error") or not rec.get("fingerprint"):
        die(f"SSH key provisioning failed: {rec.get('error') or out.strip()}")
    _store_secret("gitaly-benchmark-ssh-key", {"private_key": private_key})
    print(
        f"  SSH key for {rec['user']} ({rec['fingerprint']}) stored in "
        f"secret gitaly-benchmark-ssh-key/{GITLAB_NAMESPACE}",
        file=sys.stderr,
    )


def _gitaly_relative_path(disk_path: str) -> str:
    # Rails returns disk_path without the trailing `.git`; Gitaly's
    # gRPC relativePath expects it.
    return disk_path if disk_path.endswith(".git") else f"{disk_path}.git"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument(
        "--write-config",
        action="store_true",
        help="Edit experiments/${EXPERIMENT}/config.yml in place, "
        "adding `disk_path:` keys next to each repo's `name:`.",
    )
    ap.add_argument(
        "--reset",
        action="store_true",
        help="Remove and re-import existing benchmark repositories before provisioning.",
    )
    ap.add_argument(
        "--experiment",
        default=os.environ.get("EXPERIMENT"),
        help="Experiment directory name (defaults to $EXPERIMENT).",
    )
    args = ap.parse_args()

    if not args.experiment:
        die("EXPERIMENT must be set (or pass --experiment)")

    cfg_path = BENCH_DIR / "experiments" / args.experiment / "config.yml"
    if not cfg_path.is_file():
        die(f"experiment config not found: {cfg_path}")

    cfg = _load(cfg_path)
    repos = cfg.get("repositories") or []
    if not repos:
        die(f"no repositories defined in {cfg_path}")

    specs = []
    for r in repos:
        name = r.get("name")
        remote = r.get("remote")
        if not name or not remote:
            die(
                f"repository entry missing required name/remote: {r!r}\n  in {cfg_path}"
            )
        spec = {"name": str(name), "remote": str(remote)}
        if r.get("revision"):
            spec["revision"] = str(r["revision"])
        extra = r.get("additional_refs")
        if isinstance(extra, int) and extra > 0:
            spec["additional_refs"] = str(extra)
        specs.append(spec)

    pod = find_toolbox_pod()

    # One (group, Rails storage, config.yml key prefix) per project set. The
    # control set only exists when its storage is registered in Rails.
    sides = [(BENCH_GROUP, "default", "")]
    storages = rails_storages(pod)
    if CONTROL_STORAGE_NAME in storages:
        sides.append((BENCH_CONTROL_GROUP, CONTROL_STORAGE_NAME, "control_"))
    else:
        print(
            f"[provision] storage {CONTROL_STORAGE_NAME!r} not registered in "
            f"Rails (have: {', '.join(storages) or 'none'}); skipping the "
            "control-side project set. Comparison runs need it: register "
            "the control Gitaly as an external storage in the chart values.",
            file=sys.stderr,
        )

    print(
        "[provision] toolbox=" + pod + " sides="
        + ", ".join(f"{g} (storage={s})" for g, s, _ in sides),
        file=sys.stderr,
    )

    results: dict[str, dict[str, dict]] = {}
    for group, storage, prefix in sides:
        if args.reset:
            print(f"[provision] resetting repositories in {group}", file=sys.stderr)
            reset_repositories(pod, group, specs)

        created = provision(pod, group, storage, specs)
        failures = {n: r for n, r in created.items() if r.get("error")}
        if failures:
            die(
                f"project creation failed in {group}:\n  "
                + "\n  ".join(f"{n}: {r['error']}" for n, r in failures.items())
            )

        print(f"[provision] waiting for imports in {group}", file=sys.stderr)
        status = wait_for_imports(pod, group, [s["name"] for s in specs])

        failed = [
            n
            for n, r in status.items()
            if r.get("import_status") == "failed" or r.get("missing")
        ]
        # The MVCC backend lacks RepositoryInfo, so Rails bookkeeping can
        # mark an import "failed" even when the clone succeeded. Tolerate
        # readable repos; revision enforcement still catches broken ones.
        for n in list(failed):
            r = status[n]
            if not r.get("missing") and r.get("branches", -1) > 0:
                print(
                    f"  {group}/{n}: import marked failed but repository "
                    f"is readable ({r['branches']} branches); continuing "
                    f"(error was: {r.get('import_error')})",
                    file=sys.stderr,
                )
                failed.remove(n)
        if failed:
            die(
                f"imports failed in {group}:\n  "
                + "\n  ".join(
                    f"{n}: {status[n].get('import_error') or 'missing'}"
                    for n in failed
                )
            )

        print(f"[provision] sweeping stray benchmark refs in {group}", file=sys.stderr)
        sweep_stray_refs(pod, group, [s["name"] for s in specs])

        print(
            f"[provision] fetching remotes where pinned revisions are "
            f"missing in {group}",
            file=sys.stderr,
        )
        fetch_missing_revisions(pod, group, specs)

        print(f"[provision] enforcing pinned revisions in {group}", file=sys.stderr)
        enforce_revisions(pod, group, specs)

        print(
            f"[provision] creating additional benchmark refs in {group} "
            "(can take several minutes on first run)",
            file=sys.stderr,
        )
        create_additional_refs(pod, group, specs)

        results[prefix] = created

    print("[provision] minting PAT for the http push transport", file=sys.stderr)
    mint_push_token(pod)

    print("[provision] minting SSH key for the ssh transport", file=sys.stderr)
    mint_ssh_key(pod)

    # No ref-packing on either side: MVCC has no packed-refs, and packing
    # only the control would give the sides different ref layouts.

    # Write each side's disk_path back to its repo entry (control keys get
    # the control_ prefix). gl_repository rides along for the push
    # sections' pre-receive hook.
    for r in repos:
        for prefix, created in results.items():
            meta = created.get(str(r["name"]))
            if not meta or not meta.get("disk_path"):
                continue
            r[f"{prefix}disk_path"] = _gitaly_relative_path(meta["disk_path"])
            if meta.get("gl_repository"):
                r[f"{prefix}gl_repository"] = meta["gl_repository"]

    if args.write_config:
        _dump(cfg, cfg_path)
        print(
            f"[provision] wrote disk_path/gl_repository entries to {cfg_path}",
            file=sys.stderr,
        )
    else:
        print("# paste this into the corresponding entry in", cfg_path)
        for r in repos:
            for prefix, _created in results.items():
                if f"{prefix}disk_path" not in r:
                    continue
                print(f"  {prefix}disk_path: {r[f'{prefix}disk_path']!r}")
                if f"{prefix}gl_repository" in r:
                    print(f"  {prefix}gl_repository: {r[f'{prefix}gl_repository']!r}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
