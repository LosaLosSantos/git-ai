# Base image for ko builds with all required dependencies
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

ARG GITLAB_USER=git
ARG UID=1000

# Install all required dependencies including git
RUN microdnf update -y && \
    microdnf install -y --nodocs --best --setopt=install_weak_deps=0 \
      shadow-utils \
      git \
      git-core \
      iproute \
      libicu \
      openssh-clients \
      bzip2 \
      gzip \
      procps-ng \
      tzdata && \
    microdnf clean all

# Create git user and required directories
RUN adduser -u ${UID} -m ${GITLAB_USER} && \
    mkdir -p \
      /etc/gitaly \
      /var/log/gitaly \
      /home/${GITLAB_USER}/repositories \
      /home/${GITLAB_USER}/custom_hooks \
      /srv/gitlab-shell && \
    touch /var/log/gitaly/gitaly.log && \
    touch /var/log/gitaly/gitlab-shell.log && \
    chown -R ${UID}:0 \
      /etc/gitaly \
      /var/log/gitaly \
      /home/${GITLAB_USER}/repositories \
      /home/${GITLAB_USER}/custom_hooks \
      /srv/gitlab-shell \
      /home/${GITLAB_USER} && \
    chmod -R g=u \
      /etc/gitaly \
      /var/log/gitaly \
      /home/${GITLAB_USER}/repositories \
      /home/${GITLAB_USER}/custom_hooks \
      /srv/gitlab-shell \
      /home/${GITLAB_USER}

USER ${UID}
